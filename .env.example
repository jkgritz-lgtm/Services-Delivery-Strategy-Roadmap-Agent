# Vertex AI / Gemini Enterprise Configuration
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
STAGING_BUCKET=gs://your-staging-bucket

# Model Selection (PRD Specification: gemini-3.1-pro-preview)
MODEL_NAME=gemini-3.1-pro-preview

# Google Workspace OAuth Configuration for Google Slides API
# Option A: OAuth2 Client ID & Secret (for Gemini Enterprise interactive OAuth)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Option B: Direct OAuth Access Token or Application Default Credentials (ADC)
GOOGLE_OAUTH_ACCESS_TOKEN=

# Set to true for local testing without calling live Google Slides API
SLIDES_DRY_RUN=false
